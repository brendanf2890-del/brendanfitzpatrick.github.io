    <!-- ============ FORMULA: variance decomposition + classification ======= -->
    <Node ToolID="8">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="606" y="180" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="ToNumber([sched_timely_dth]) - ToNumber([sched_final_dth])" field="cut_dth" size="8" type="Double" />
            <FormulaField expression="ToNumber([sched_final_dth]) - ToNumber([allocated_dth])" field="alloc_var_dth" size="8" type="Double" />
            <FormulaField expression="ToNumber([delivered_dth]) - ToNumber([allocated_dth])" field="total_break_dth" size="8" type="Double" />
            <FormulaField expression="ToNumber([allocated_dth]) - ToNumber([confirmed_dth])" field="cp_var_dth" size="8" type="Double" />
            <FormulaField expression="ToNumber([receipt_allocated_dth]) - ToNumber([allocated_dth])" field="net_imbalance_dth" size="8" type="Double" />
            <FormulaField expression="IF ToNumber([delivered_dth])=0 OR ToNumber([allocated_dth])=0 THEN &quot;&quot;&#10;ELSEIF ((ToNumber([delivered_dth])&gt;0)!=(ToNumber([allocated_dth])&gt;0)) AND Abs(Abs(ToNumber([delivered_dth]))-Abs(ToNumber([allocated_dth])))&lt;=0.01*Abs(ToNumber([allocated_dth])) THEN &quot;SIGN INVERSION (equal magnitude, opposite sign) - canonicalize, do not Abs() away&quot;&#10;ELSEIF ((ToNumber([delivered_dth])&gt;0)!=(ToNumber([allocated_dth])&gt;0)) THEN &quot;SIGN DISAGREEMENT (real directional break)&quot;&#10;ELSEIF Abs(Abs(ToNumber([delivered_dth])/ToNumber([allocated_dth]))-10)&lt;=0.1 THEN &quot;UNIT MISMATCH ~10:1 (therms reported as Dth?)&quot;&#10;ELSEIF Abs(Abs(ToNumber([delivered_dth])/ToNumber([allocated_dth]))-0.1)&lt;=0.001 THEN &quot;UNIT MISMATCH ~1:10&quot;&#10;ELSEIF Abs(Abs(ToNumber([delivered_dth])/ToNumber([allocated_dth]))-1000)&lt;=10 THEN &quot;UNIT MISMATCH ~1000:1&quot;&#10;ELSE &quot;&quot; ENDIF" field="unit_sign_flag" size="200" type="V_WString" />
            <FormulaField expression="IF [unit_sign_flag]!=&quot;&quot; THEN &quot;REVIEW DATA QUALITY&quot; ELSEIF Abs([total_break_dth])&lt;=0 AND Abs([cp_var_dth])&lt;=0 THEN &quot;TIE&quot; ELSE &quot;BREAK&quot; ENDIF" field="status" size="20" type="V_WString" />
            <FormulaField expression="IF [status]=&quot;TIE&quot; THEN &quot;Book = allocation = counterparty&quot;&#10;ELSEIF Abs([cut_dth])&gt;=Abs([alloc_var_dth]) AND [cut_dth]!=0 THEN &quot;Uncaptured scheduling cut &quot;+ToString([cut_dth],0)+&quot; Dth (book stored Timely nomination, not final scheduled). &quot;+[cut_reason]&#10;ELSEIF [alloc_var_dth]!=0 THEN &quot;Allocation variance &quot;+ToString([alloc_var_dth],0)+&quot; Dth (final scheduled vs pool allocation; method=&quot;+[alloc_method]+&quot;)&quot;&#10;ELSEIF [cp_var_dth]!=0 THEN &quot;Counterparty statement disagrees with pipeline allocation &quot;+ToString([cp_var_dth],0)+&quot; Dth (pipeline allocation is Tier-1 truth)&quot;&#10;ELSE &quot;Book vs allocation gap with no scheduled-cycle attribution&quot; ENDIF" field="root_cause" size="500" type="V_WString" />
            <FormulaField expression="IF Abs([net_imbalance_dth])&gt;0 THEN &quot;NET IMBALANCE &quot;+ToString([net_imbalance_dth],0)+&quot; Dth - cut did not hit both legs evenly&quot; ELSE &quot;Receipts = deliveries (nil imbalance)&quot; ENDIF" field="imbalance_flag" size="200" type="V_WString" />
            <FormulaField expression="ToNumber([index_price]) + ToNumber([basis])" field="all_in_price" size="8" type="Double" />
            <FormulaField expression="IF Uppercase([is_final])=&quot;Y&quot; THEN &quot;Final&quot; ELSE &quot;PRELIMINARY&quot; ENDIF" field="price_status" size="12" type="V_WString" />
            <FormulaField expression="[total_break_dth] * ([all_in_price])" field="cash_delta_usd" size="8" type="Double" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Stage 4: decompose break = cut + alloc_var; rank cause; cash impact</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>

